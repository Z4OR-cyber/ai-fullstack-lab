# ============================================================
# SecScan 环境变量模板
# 使用方法：cp .env.example .env，然后修改为实际值
# 注意：.env 文件包含敏感信息，绝不能提交到 Git！
# ============================================================

# ---- 应用配置 ----
APP_PORT=8000
ENVIRONMENT=production
DEBUG=false

# ---- PostgreSQL 配置 ----
POSTGRES_USER=secscan
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=secscan_db
DB_PORT=5432

# ---- ChromaDB 配置（向量数据库，用于AI语义检索）----
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---- 应用密钥（生产环境务必修改为随机强密钥）----
SECRET_KEY=generate_a_random_secret_key_here

# ---- 数据库连接字符串（由上面的变量组合而成）----
DATABASE_URL=postgresql://secscan:change_me_to_a_strong_password@postgres:5432/secscan_db

# ---- CORS 跨域配置 ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- 日志级别 ----
LOG_LEVEL=info
