# ============================================================
# 第3题：环境变量模板
# 使用方法：cp .env.example .env，然后修改为实际值
# 注意：.env 文件包含敏感信息，绝不能提交到 Git！
# ============================================================

# ---- 应用配置 ----
APP_PORT=8000
ENVIRONMENT=production
DEBUG=false

# ---- PostgreSQL 配置 ----
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=todo_db
DB_PORT=5432

# ---- Redis 配置 ----
REDIS_PORT=6379

# ---- 应用密钥（生产环境务必修改）----
SECRET_KEY=generate_a_random_secret_key_here
